# Copy to .env for local runs from backend/. Existing process/host variables
# take precedence over values in this file.
LYRICS_HTTP_ADDR=0.0.0.0:8080
LYRICS_STORAGE_DRIVER=sqlite
LYRICS_DB_PATH=data/lyrics.db
LYRICS_DATABASE_URL=
LYRICS_CORS_ORIGINS=http://localhost:5173
LYRICS_FFMPEG_DIR=../tools
LYRICS_ASSETS_DIR=assets
LYRICS_RENDER_DIR=data/renders
LYRICS_METRICS_ADDR=127.0.0.1:9090
LYRICS_LOG_LEVEL=info
