# Copy to .env for compose.app.yml. Do not put secrets in version control.
VITE_API_URL=http://localhost:8080
LYRICS_CORS_ORIGINS=http://localhost:8081
YOUTUBE_API_KEY=
LYRICS_STORAGE_DRIVER=sqlite
LYRICS_DATABASE_URL=

# Only for the local PostgreSQL Compose override; never reuse these credentials
# in a hosted environment.
POSTGRES_USER=lyrics
POSTGRES_PASSWORD=lyrics_dev_password
POSTGRES_DB=lyrics