{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (route) (rate(lyrics_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "HTTP requests per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(lyrics_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}} p95", "refId": "A"}],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum by (status) (rate(lyrics_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "HTTP {{status}}", "refId": "A"}],
      "title": "5xx error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "lyrics_http_requests_in_flight", "legendFormat": "in flight", "refId": "A"}],
      "title": "Requests in flight",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "{job=\"lyrics-api\"} | json", "queryType": "range", "refId": "A"}],
      "title": "API logs",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["lyrics", "api", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Lyrics API - production",
  "uid": "lyrics-api-production",
  "version": 1
}